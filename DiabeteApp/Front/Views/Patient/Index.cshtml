@{
    ViewData["Title"] = "Liste des patients";
}

@model List<Front.ViewModels.PatientListViewModel>

<h2>Liste des patients</h2>

<a class="btn btn-primary" href="/Patient/Create">Créer un patient</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Prénom</th>
            <th>Nom</th>
            <th>Date de naissance</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Prenom</td>
                <td>@p.Nom</td>
                <td>@p.DateDeNaissance.ToShortDateString()</td>
                <td>
                    <a class="btn btn-primary" href="/Patient/Details/@p.Id">Détails</a>
                </td>
            </tr>
        }
    </tbody>
</table>
