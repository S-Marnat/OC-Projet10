@model Front.ViewModels.PatientDetailsViewModel

<h3 class="card-title text-center">@Model.Prenom @Model.Nom</h3>

<div class="mt-4 text-center">
    <a class="btn btn-primary me-2"
       asp-controller="Patient"
       asp-action="Edit"
       asp-route-id="@Model.Id">
        Modifier les informations du patient
    </a>
</div>

<p><strong>Prénom :</strong> @Model.Prenom</p>
<p><strong>Nom :</strong> @Model.Nom</p>
<p><strong>Date de naissance :</strong> @Model.DateDeNaissance.ToShortDateString()</p>
<p><strong>Genre :</strong> @Model.Genre</p>
<p><strong>Adresse :</strong> @Model.Adresse</p>
<p><strong>Téléphone :</strong> @Model.Telephone</p>
