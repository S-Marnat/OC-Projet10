{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/account/login",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7088
        }
      ],
      "UpstreamPathTemplate": "/account/login",
      "UpstreamHttpMethod": [ "POST" ]
    },

    {
      "DownstreamPathTemplate": "/api/account/logout",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7088
        }
      ],
      "UpstreamPathTemplate": "/account/logout",
      "UpstreamHttpMethod": [ "POST" ]
    },

    {
      "DownstreamPathTemplate": "/api/account/refresh",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7088
        }
      ],
      "UpstreamPathTemplate": "/account/refresh",
      "UpstreamHttpMethod": [ "POST" ]
    },


    {
